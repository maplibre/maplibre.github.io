---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import "photoswipe/style.css";

interface Props {
  src: ImageMetadata;
  alt: string;
  style?: Record<string, string>;
}

const { src, alt, style } = Astro.props;
---

<a
  class="zoomable-image"
  href={src.src}
  data-pswp-width={src.width}
  data-pswp-height={src.height}
  aria-label={`Enlarge: ${alt}`}
>
  <Image src={src} alt={alt} style={style} />
</a>

<style>
  .zoomable-image {
    display: block;
    width: 100%;
    min-width: 0;
    cursor: zoom-in;
  }

  .zoomable-image :global(img) {
    display: block;
  }

  /* Grid gaps provide spacing between adjacent images. */
  .zoomable-image ~ .zoomable-image {
    margin-top: 0;
  }
</style>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";

  let lightbox: PhotoSwipeLightbox | undefined;

  document.addEventListener("astro:before-swap", () => {
    lightbox?.destroy();
    lightbox = undefined;
  });

  document.addEventListener("astro:page-load", () => {
    lightbox?.destroy();
    lightbox = new PhotoSwipeLightbox({
      gallery: "a.zoomable-image",
      pswpModule: () => import("photoswipe"),
    });
    lightbox.init();
  });
</script>
